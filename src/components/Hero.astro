---
import Carousel from "./Carousel.astro";
import Pillars from "./Pillars.astro";
---

<section class="hero" id="inicio">
  <div class="wrap hero-grid">
    <div>
      <p class="label">Medicina Integrativa · Pedra Branca - Palhoça / SC</p>
      <h1 style="margin-top:22px">Descubra a leveza <em>de transformar sua saúde</em></h1>
      <p class="sub">Medicina Integrativa, acompanhamento médico completo, emagrecimento com supervisão médica, harmonização facial, estética corporal e tratamentos capilares.</p>
      <div class="actions">
        <a class="btn" href="#tratamentos">Conheça os tratamentos <span class="arr"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"/></svg></span></a>
        <a class="link" href="#contato">Agendar consulta</a>
      </div>
    </div>
    <Carousel />
  </div>
  <Pillars />
</section>
