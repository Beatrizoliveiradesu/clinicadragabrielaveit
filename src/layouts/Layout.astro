---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dra. Gabriela Veit",
  description = "Dra. Gabriela Veit — Medicina Integrativa, acompanhamento médico do emagrecimento, longevidade e estética facial e corporal em Palhoça, Grande Florianópolis."
} = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Roboto:wght@300;400;500&display=swap" />
</head>
<body>
  <slot />

  <script src="../scripts/main.js"></script>
</body>
</html>
